# deriv_under8_bot.py
# Simple Deriv "UNDER 8" digits bot (Python, asyncio + websockets)
# Requirements: pip install websockets
# WARNING: Test on demo account. Trading is high risk.

import asyncio
import websockets
import json
from collections import deque
import time
import random

# ---------- CONFIG ----------
API_TOKEN = None   # <-- Put your Deriv API token here (string). If None, bot will NOT place buys (demo/watch mode).
APP_ID = 1089      # public/demo app_id used in many examples (you can register your own app_id)
WS_URL = f"wss://ws.derivws.com/websockets/v3?app_id={APP_ID}"

SYMBOL = "R_100"           # synthetic symbol to trade digits on. Change if needed (check active_symbols).
WINDOW = 20                # how many recent last-digits to analyze
THRESHOLD = 0.75           # trigger when proportion of digits < 8 >= THRESHOLD (e.g. 0.75 => 75%)
STAKE = 1.0                # stake per trade (in account currency)
MAX_TRADES = 200           # safety limit
DURATION_TICKS = 8         # "under 8" — number of ticks duration for the contract (common for digit strategies)
MARTINGALE = [1.0, 2.0, 3.0]  # optional stake multipliers on loss (simple martingale)
AUTO_BUY = True            # if False, the bot will only show proposals (set to False for dry-run)
VERBOSE = True
# ----------------------------

def log(*args):
    if VERBOSE:
        print(time.strftime("%Y-%m-%d %H:%M:%S"), *args)

class DerivUnder8Bot:
    def __init__(self, ws, api_token=None):
        self.ws = ws
        self.api_token = api_token
        self.digits = deque(maxlen=WINDOW)
        self.trade_count = 0
        self.in_trade = False
        self.pending_buy_req_id = None
        self.req_id_counter = 1000
        self.passthrough_map = {}  # map req_id to metadata
        self.loss_streak = 0

    def _next_req_id(self):
        self.req_id_counter += 1
        return self.req_id_counter

    async def authorize(self):
        if not self.api_token:
            log("No API token set — running in monitor / demo-only mode (will not place authenticated buys).")
            return
        req = {"authorize": self.api_token}
        await self.ws.send(json.dumps(req))
        log("Sent authorize request (token)")

    async def subscribe_ticks(self):
        # subscribe to tick stream for SYMBOL
        req = {"ticks": SYMBOL, "subscribe": 1}
        await self.ws.send(json.dumps(req))
        log(f"Subscribed to ticks for {SYMBOL}")

    async def request_proposal_and_buy(self, stake):
        """
        Request a proposal for DIGITUNDER with barrier 8 and duration in ticks,
        then buy using the proposal id returned.
        """
        # Build proposal request
        req_id = self._next_req_id()
        proposal_req = {
            "proposal": 1,
            "subscribe": 1,
            "amount": stake,
            "basis": "stake",
            "contract_type": "DIGITUNDER",
            "symbol": SYMBOL,
            "duration": DURATION_TICKS,
            "duration_unit": "t",   # 't' => ticks
            "barrier": "8",
            "currency": "USD"       # change if your account uses a different currency
        }
        # send proposal (noting req_id in passthrough)
        echo = {"mode": "under8_bot", "req_id": req_id, "stake": stake}
        proposal_req["passthrough"] = echo
        proposal_req["req_id"] = req_id

        await self.ws.send(json.dumps(proposal_req))
        log(f"Sent proposal request (req_id={req_id}) stake={stake}")
        # We'll wait for proposal response in the on_message handler
        return req_id

    async def handle_message(self, msg):
        # parse JSON from server
        try:
            data = json.loads(msg)
        except Exception:
            return

        # Authorization response
        if "authorize" in data:
            log("Authorize response:", data.get("authorize", {}))

        # ticks response
        if data.get("tick"):
            tick = data["tick"]
            quote = tick.get("quote")
            if quote is None:
                return
            last_digit = int(str(quote)[-1])
            self.digits.append(last_digit)
            log(f"Tick: {quote} -> last_digit={last_digit}  window_count={len(self.digits)}")

            # analyze window when full
            if len(self.digits) == WINDOW and not self.in_trade:
                count_under8 = sum(1 for d in self.digits if d < 8)
                ratio = count_under8 / WINDOW
                log(f"Under8 ratio over last {WINDOW} ticks = {count_under8}/{WINDOW} = {ratio:.2f}")
                if ratio >= THRESHOLD and self.trade_count < MAX_TRADES:
                    # determine stake (apply martingale based on loss streak)
                    mg_index = min(self.loss_streak, len(MARTINGALE)-1)
                    stake = STAKE * MARTINGALE[mg_index]
                    # request proposal + buy
                    if AUTO_BUY and self.api_token:
                        req_id = await self.request_proposal_and_buy(stake)
                        self.pending_buy_req_id = req_id
                        self.passthrough_map[req_id] = {"type":"proposal", "stake": stake}
                        # mark that we're waiting for proposal/buy outcome
                    else:
                        # If not authorized or AUTO_BUY False, just show suggestion
                        log(f"DRY RUN: Condition met (ratio {ratio:.2f}). Suggested stake={stake}")
                        # (optional) reset sliding window to avoid immediate re-fire
                        self.digits.clear()

        # proposal response (quote for the buy)
        if "proposal" in data:
            # proposal returns a token id; we need to buy with that id
            prop = data["proposal"]
            req_id = data.get("req_id") or (data.get("passthrough") or {}).get("req_id")
            if req_id:
                log(f"Proposal received (req_id={req_id}) -> {prop}")
            else:
                log("Proposal received:", prop)
            # If proposal contains 'id' we can send buy
            proposal_id = prop.get("id")
            if proposal_id and AUTO_BUY and self.api_token:
                # buy the proposal using 'buy' with buy=proposal_id
                buy_req = {"buy": proposal_id, "price": prop.get("ask_price"), "req_id": self._next_req_id()}
                buy_req["passthrough"] = {"note": "under8_buy"}
                await self.ws.send(json.dumps(buy_req))
                log(f"Sent buy for proposal id {proposal_id} price {prop.get('ask_price')}")

        # buy response -> contains contract_id and whether win/loss at contract close events
        if "buy" in data:
            buy = data["buy"]
            log("Buy response:", buy)
            # we are now in trade and should monitor result with proposal_open_contract updates
            self.in_trade = True
            self.trade_count += 1
            # After purchase, the server will send updates about this contract via 'proposal_open_contract' messages.

        # contract update messages (status and profit/loss)
        if "proposal_open_contract" in data:
            poc = data["proposal_open_contract"]
            status = poc.get("status")
            contract_id = poc.get("contract_id")
            profit = poc.get("profit")  # positive if won, negative if lost (or used buy/buy_price to compute)
            # note: 'profit' may not always be present depending on message type.
            log(f"Contract update id={contract_id} status={status} profit={profit}")
            if status == "sold" or status == "won" or status == "lost" or status == "finished":
                # evaluate win/loss by comparing 'profit' or 'sell_price' vs spent
                # a simple heuristic:
                if profit is not None:
                    if profit > 0:
                        self.loss_streak = 0
                        log(f"TRADE WON: profit={profit}")
                    else:
                        self.loss_streak += 1
                        log(f"TRADE LOST/NO PROFIT: profit={profit} (loss_streak={self.loss_streak})")
                else:
                    log("Contract finished (no profit field).")
                # allow new trades
                self.in_trade = False
                # small cooldown to avoid immediate re-entry
                self.digits.clear()

        # keepalive / error handling / other messages
        if "error" in data:
            log("API error:", data["error"])

    async def keepalive_ping(self):
        # send periodic ping to prevent session timeout
        while True:
            await asyncio.sleep(25)
            try:
                await self.ws.send(json.dumps({"ping": 1}))
            except Exception as e:
                log("Ping error:", e)
                break

async def main():
    log("Starting Deriv Under-8 bot")
    async with websockets.connect(WS_URL) as ws:
        bot = DerivUnder8Bot(ws, api_token=API_TOKEN)
        # authorize if token provided
        await bot.authorize()
        # subscribe to ticks
        await bot.subscribe_ticks()
        # start ping loop
        asyncio.create_task(bot.keepalive_ping())

        # main receive loop
        while True:
            try:
                msg = await ws.recv()
            except websockets.ConnectionClosed:
                log("Connection closed by server")
                break
            except Exception as e:
                log("Recv error:", e)
                break
            # handle message
            await bot.handle_message(msg)

if __name__ == "__main__":
    try:
        asyncio.get_event_loop().run_until_complete(main())
    except KeyboardInterrupt:
        log("Exiting on user interrupt")
