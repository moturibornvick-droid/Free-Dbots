<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="var_prediction">Prediction</variable>
    <variable type="" id="var_time">Time</variable>
    <variable type="" id="var_initial_stake">InitialStake</variable>
    <variable type="" id="var_current_stake">CurrentStake</variable>
    <variable type="" id="var_mg_factor">MartingaleFactor</variable>
    <variable type="" id="var_mg_steps">MGSteps</variable>
    <variable type="" id="var_loss_streak">LossStreak</variable>
    <variable type="" id="var_take_profit">TakeProfit</variable>
    <variable type="" id="var_stop_loss">StopLoss</variable>
    <variable type="" id="var_max_mg">MaxMG</variable>
  </variables>

  <!-- Main trade block: DIGITUNDER on R_100, every tick (duration 1 tick) -->
  <block type="trade" id="trade_main" x="0" y="0">
    <field name="MARKET_LIST">synthetic_index</field>
    <field name="SUBMARKET_LIST">random_index</field>
    <field name="SYMBOL_LIST">R_100</field>
    <field name="TRADETYPECAT_LIST">digits</field>
    <field name="TRADETYPE_LIST">overunder</field>
    <field name="TYPE_LIST">DIGITUNDER</field>
    <field name="CANDLEINTERVAL_LIST">1</field>
    <field name="TIME_MACHINE_ENABLED">FALSE</field>
    <field name="RESTARTONERROR">TRUE</field>

    <!-- Initialization: set variables -->
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_1">
        <field name="VAR" id="var_prediction">Prediction</field>
        <value name="VALUE">
          <block type="math_number" id="num_pred">
            <field name="NUM">8</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_2">
            <field name="VAR" id="var_time">Time</field>
            <value name="VALUE">
              <block type="math_number" id="num_time">
                <field name="NUM">1</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_3">
                <field name="VAR" id="var_initial_stake">InitialStake</field>
                <value name="VALUE">
                  <block type="math_number" id="num_stake">
                    <field name="NUM">0.35</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_4">
                    <field name="VAR" id="var_current_stake">CurrentStake</field>
                    <value name="VALUE">
                      <block type="variables_get" id="get_init_stake">
                        <field name="VAR" id="var_initial_stake">InitialStake</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_5">
                        <field name="VAR" id="var_mg_factor">MartingaleFactor</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_mg">
                            <field name="NUM">2.3</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_6">
                            <field name="VAR" id="var_mg_steps">MGSteps</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_mg_steps">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_7">
                                <field name="VAR" id="var_loss_streak">LossStreak</field>
                                <value name="VALUE">
                                  <block type="math_number" id="num_loss">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_8">
                                    <field name="VAR" id="var_take_profit">TakeProfit</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="num_tp">
                                        <field name="NUM">10</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="init_9">
                                        <field name="VAR" id="var_stop_loss">StopLoss</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="num_sl">
                                            <field name="NUM">30</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="init_10">
                                            <field name="VAR" id="var_max_mg">MaxMG</field>
                                            <value name="VALUE">
                                              <block type="math_number" id="num_maxmg">
                                                <field name="NUM">5</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>

    <!-- Submarket/trade options: duration = 1 tick, currency USD -->
    <statement name="SUBMARKET">
      <block type="tradeOptions" id="opts">
        <field name="DURATIONTYPE_LIST">t</field>
        <field name="CURRENCY_LIST">USD</field>
        <field name="BARRIEROFFSETTYPE_LIST">+</field>
        <field name="SECONDBARRIEROFFSETTYPE_LIST">-</field>
        <value name="DURATION">
          <block type="variables_get" id="get_time">
            <field name="VAR" id="var_time">Time</field>
          </block>
        </value>
        <value name="AMOUNT">
          <block type="variables_get" id="get_amount">
            <field name="VAR" id="var_current_stake">CurrentStake</field>
          </block>
        </value>
        <value name="PREDICTION">
          <block type="variables_get" id="get_pred">
            <field name="VAR" id="var_prediction">Prediction</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BEFORE PURCHASE: buy on every tick immediately (fast). No digit filter — executes every tick. -->
  <block type="before_purchase" id="before" x="0" y="420">
    <statement name="BEFOREPURCHASE_STACK">
      <!-- Purchase block triggers immediate purchase of DIGITUNDER with current stake -->
      <block type="purchase" id="buy_now">
        <field name="PURCHASE_LIST">DIGITUNDER</field>
      </block>
    </statement>
  </block>

  <!-- AFTER PURCHASE: update win/loss, manage martingale, check TP/SL and stop if limits hit -->
  <block type="after_purchase" id="after" x="0" y="720">
    <statement name="AFTERPURCHASE_STACK">
      <!-- If last contract result = win -->
      <block type="controls_if" id="after_if">
        <mutation else="1"></mutation>
        <value name="IF0">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO0">
          <!-- On win: reset stake to initial, reset mg steps and loss streak -->
          <block type="variables_set" id="on_win_reset">
            <field name="VAR" id="var_current_stake">CurrentStake</field>
            <value name="VALUE">
              <block type="variables_get" id="get_initial_for_reset">
                <field name="VAR" id="var_initial_stake">InitialStake</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_mg">
                <field name="VAR" id="var_mg_steps">MGSteps</field>
                <value name="VALUE">
                  <block type="math_number" id="zero_mg">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_loss">
                    <field name="VAR" id="var_loss_streak">LossStreak</field>
                    <value name="VALUE">
                      <block type="math_number" id="zero_loss">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <!-- Informational notify of win with profit detail -->
                      <block type="notify" id="notify_win">
                        <field name="NOTIFICATION_TYPE">success</field>
                        <field name="NOTIFICATION_SOUND">silent</field>
                        <value name="MESSAGE">
                          <block type="text_join" id="join_win">
                            <mutation items="2"></mutation>
                            <value name="ADD0">
                              <block type="text" id="txt_won">
                                <field name="TEXT">WIN — Total Profit: </field>
                              </block>
                            </value>
                            <value name="ADD1">
                              <block type="total_profit" id="tp_after_win"></block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <!-- ELSE (not win: treat as loss or neutral) -->
        <statement name="ELSE">
          <!-- Notify loss and increase martingale -->
          <block type="notify" id="notify_loss">
            <field name="NOTIFICATION_TYPE">warn</field>
            <field name="NOTIFICATION_SOUND">silent</field>
            <value name="MESSAGE">
              <block type="text_join" id="join_loss">
                <mutation items="2"></mutation>
                <value name="ADD0">
                  <block type="text" id="txt_lost">
                    <field name="TEXT">LOSS — Total Profit: </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="total_profit" id="tp_after_loss"></block>
                </value>
              </block>
            </value>
            <next>
              <!-- increment LossStreak -->
              <block type="math_change" id="inc_loss">
                <field name="VAR" id="var_loss_streak">LossStreak</field>
                <value name="DELTA">
                  <block type="math_number" id="one_num">
                    <field name="NUM">1</field>
                  </block>
                </value>
                <next>
                  <!-- increment MGSteps -->
                  <block type="math_change" id="inc_mg_steps">
                    <field name="VAR" id="var_mg_steps">MGSteps</field>
                    <value name="DELTA">
                      <block type="math_number" id="one_num2">
                        <field name="NUM">1</field>
                      </block>
                    </value>
                    <next>
                      <!-- Calculate new CurrentStake = CurrentStake * MartingaleFactor (but only if MGSteps <= MaxMG) -->
                      <block type="controls_if" id="mg_check">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare" id="cmp_mg">
                            <field name="OP">LTE</field>
                            <value name="A">
                              <block type="variables_get" id="get_mg_steps_comp">
                                <field name="VAR" id="var_mg_steps">MGSteps</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="variables_get" id="get_max_mg_comp">
                                <field name="VAR" id="var_max_mg">MaxMG</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <!-- apply martingale -->
                          <block type="variables_set" id="apply_mg">
                            <field name="VAR" id="var_current_stake">CurrentStake</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="calc_mg">
                                <field name="OP">MULTIPLY</field>
                                <value name="A">
                                  <block type="variables_get" id="get_cur_stake_for_mg">
                                    <field name="VAR" id="var_current_stake">CurrentStake</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="variables_get" id="get_mg_factor_for_mg">
                                    <field name="VAR" id="var_mg_factor">MartingaleFactor</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <!-- If exceeded max MG steps: stop trading and notify -->
                          <block type="notify" id="notify_max_mg">
                            <field name="NOTIFICATION_TYPE">error</field>
                            <field name="NOTIFICATION_SOUND">silent</field>
                            <value name="MESSAGE">
                              <block type="text">
                                <field name="TEXT">Max martingale reached — stopping bot.</field>
                              </block>
                            </value>
                            <next>
                              <block type="stop" id="stop_bot"></block>
                            </next>
                          </block>
                        </statement>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>

        <!-- After either branch: check TP/SL and stop if reached -->
        <next>
          <block type="controls_if" id="tp_sl_check">
            <mutation else="1"></mutation>
            <value name="IF0">
              <block type="logic_operation" id="op_tp_or_sl">
                <field name="OP">OR</field>
                <value name="A">
                  <block type="logic_compare" id="cmp_tp">
                    <field name="OP">GTE</field>
                    <value name="A">
                      <block type="total_profit" id="tp_check_val"></block>
                    </value>
                    <value name="B">
                      <block type="variables_get" id="get_tp_var">
                        <field name="VAR" id="var_take_profit">TakeProfit</field>
                      </block>
                    </value>
                  </block>
                </value>
                <value name="B">
                  <block type="logic_compare" id="cmp_sl">
                    <field name="OP">LTE</field>
                    <value name="A">
                      <block type="total_profit" id="tp_check_val2"></block>
                    </value>
                    <value name="B">
                      <block type="math_arithmetic" id="neg_sl">
                        <field name="OP">MULTIPLY</field>
                        <value name="A">
                          <block type="variables_get" id="get_sl_var">
                            <field name="VAR" id="var_stop_loss">StopLoss</field>
                          </block>
                        </value>
                        <value name="B">
                          <block type="math_number" id="minus_one">
                            <field name="NUM">-1</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
              </block>
            </value>
            <statement name="DO0">
              <!-- Stop when TP or SL reached -->
              <block type="notify" id="notify_stop">
                <field name="NOTIFICATION_TYPE">info</field>
                <field name="NOTIFICATION_SOUND">silent</field>
                <value name="MESSAGE">
                  <block type="text_join" id="join_stop">
                    <mutation items="2"></mutation>
                    <value name="ADD0">
                      <block type="text" id="txt_stop">
                        <field name="TEXT">Target reached — stopping. Total Profit: </field>
                      </block>
                    </value>
                    <value name="ADD1">
                      <block type="total_profit" id="tp_end"></block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="stop" id="final_stop"></block>
                </next>
              </block>
            </statement>
            <statement name="ELSE">
              <!-- Otherwise: re-run immediately to buy next tick (high frequency) -->
              <block type="trade_again" id="reentry"></block>
            </statement>
          </block>
        </next>
      </block>
    </statement>
  </block>
</xml>
